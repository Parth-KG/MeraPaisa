<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Lets the app hand a downloaded update to the system installer. The user still has to grant
      it per-app in Settings and still confirms every install; this only makes the prompt possible.
      UpdateInstaller refuses to offer any APK not signed with the same key as the running app.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeraPaisa">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MeraPaisa.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Share links. The payload rides in the URL fragment, which is never sent to the
              host, so parth-kg.github.io only ever serves the "install Mera Paisa" fallback
              page and cannot see anyone's ledger. See data/ShareLink.kt.

              autoVerify needs /.well-known/assetlinks.json at the DOMAIN ROOT, meaning
              https://parth-kg.github.io/.well-known/assetlinks.json, NOT a copy under
              /MeraPaisa/. Until that file is live Android treats this as an ordinary web
              link and shows a chooser or opens the browser instead of coming straight here.
              The import screen also accepts a pasted link for exactly that reason.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="parth-kg.github.io"
                    android:pathPrefix="/MeraPaisa/s"
                    android:scheme="https" />
            </intent-filter>

            <!-- Needs no hosting at all, so it works the moment this build is installed. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="share"
                    android:scheme="merapaisa" />
            </intent-filter>
        </activity>
        <!-- Hands exported files to the share sheet as content:// URIs. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <receiver
            android:name=".widget.DebtWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>

</manifest>